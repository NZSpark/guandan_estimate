<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="掼蛋牌力"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.GuanDanScore">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- AI 源配置独立页面（doc/ai_configure.md） -->
        <activity
            android:name=".ui.AiSettingsActivity"
            android:exported="false"
            android:label="AI 源管理"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 手工拆牌页面（doc/patterns_design.md） -->
        <activity
            android:name=".ui.MeldAdjustActivity"
            android:exported="false"
            android:label="手工拆牌"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- 阶段 0 验证入口，Gemini WebView 迁移完成后移除 -->
        <activity android:name=".probe.AiProbeActivity" android:exported="true" android:label="AI Probe" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".probe.GeminiProbeActivity" android:exported="true" android:label="Gemini Probe" />
        <!-- 主界面必须 singleTask：桌面图标 / 快捷方式 / 深链再次进入时复用同一实例（onNewIntent），
             否则 standard 模式会按不同 Intent 在任务栈里堆出第二个主窗口。
             进程级 WebView 宿主也只有一个挂接目标，多实例会互相抢挂接。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
