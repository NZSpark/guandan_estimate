<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:minWidth="@dimen/touch_min"
            android:text="←" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="手工拆牌"
            android:textAppearance="@style/TextAppearance.GuanDan.SectionTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/undo"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:enabled="false"
            android:text="撤销" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:text="重置" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/summaryCard"
        style="@style/Widget.GuanDan.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/page_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/optimalTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最优拆牌"
                        android:textAppearance="@style/TextAppearance.GuanDan.Label" />

                    <TextView
                        android:id="@+id/optimalGrade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gold"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/optimalSpi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/optimalNspi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GuanDan.Label" />

                    <TextView
                        android:id="@+id/optimalNumerator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GuanDan.Label" />

                    <TextView
                        android:id="@+id/optimalRounds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GuanDan.Label" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="手工拆牌"
                        android:textAppearance="@style/TextAppearance.GuanDan.Label" />

                    <TextView
                        android:id="@+id/manualGrade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gold"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/manualSpi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/green_900"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/manualNspi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GuanDan.Label" />

                    <TextView
                        android:id="@+id/manualNumerator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GuanDan.Label" />

                    <TextView
                        android:id="@+id/manualRounds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GuanDan.Label" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/delta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.GuanDan.Body" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/page_margin"
        android:text="勾选两组及以上可合并；点卡片可改判或拆分"
        android:textAppearance="@style/TextAppearance.GuanDan.Label" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/groupList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/space_4" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/page_margin"
        android:paddingBottom="@dimen/space_3">

        <TextView
            android:id="@+id/mergeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.GuanDan.Label"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mergeSelected"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:enabled="false"
            android:text="合并所选 (0)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apply"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_2"
            android:enabled="false"
            android:text="应用结果" />
    </LinearLayout>
</LinearLayout>
